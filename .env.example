# Copy to .env.local and fill in. Never commit .env.local.
# Config is validated by src/config/env.ts at boot — a missing or malformed value crashes
# the process immediately rather than failing on the first request.

NODE_ENV=development

# Postgres — local dev runs the docker-compose PostGIS container on 5433.
# In production the application role holds DML only, never DDL (a successful injection
# still cannot drop a table); migrations run under a separate owner role.
DATABASE_URL=postgres://courte:courte@localhost:5433/courte?sslmode=disable
DATABASE_POOL_MAX=10

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (Auth.js reads these names by convention).
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (dev)
#                          https://<domain>/api/auth/callback/google      (prod)
# Separate OAuth clients per environment — never share one between dev and prod.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# How long an unconfirmed checkout holds a court before the sweeper releases it.
HOLD_TTL_MINUTES=10

# How far ahead recurring series are materialised as real bookings.
RECURRENCE_HORIZON_DAYS=365

# How long a waitlist offer stays claimable before moving to the next entry.
WAITLIST_CLAIM_MINUTES=30

# Shared secret for Vercel Cron to call protected job routes.
JOB_TRIGGER_SECRET=

LOG_LEVEL=debug
