# Root env is for dbmate only — the migration CLI runs from here because db/migrations is
# shared by nothing else. Application config lives per app:
#
#   apps/api/.env.example   the API: database pool, shared secrets, job intervals
#   apps/web/.env.example   the web app: Auth.js, Google OAuth, where the API lives
#
# Copy this to .env (dbmate reads .env, not .env.local).

DATABASE_URL=postgres://courte:courte@localhost:5433/courte?sslmode=disable
