{
  "name": "courte",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:api": "pnpm --filter @courte/api dev",
    "dev:web": "pnpm --filter @courte/web dev",
    "build": "pnpm --filter @courte/contract build && pnpm --filter './apps/*' build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @courte/contract build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "dbmate up",
    "db:rollback": "dbmate down",
    "db:status": "dbmate status"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.18.2"
}
