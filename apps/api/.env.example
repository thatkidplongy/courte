# Copy to .env.local and fill in. Never commit .env.local.
# Config is validated by src/config/env.ts at boot — a missing or malformed value crashes the
# process immediately rather than failing on the first request.

NODE_ENV=development
PORT=4000

# Postgres — local dev runs the docker-compose PostGIS container on 5433. This process is the
# ONLY holder of a connection pool (ADR 0004); the web app has no DATABASE_URL by design.
# In production the application role holds DML only, never DDL (a successful injection still
# cannot drop a table); migrations run under a separate owner role.
DATABASE_URL=postgres://courte:courte@localhost:5433/courte?sslmode=disable
DATABASE_POOL_MAX=10

# Shared with the web app, which signs the short-lived caller tokens this process verifies.
# Must be byte-identical to the web app's copy. Generate with: openssl rand -base64 32
API_JWT_SECRET=

# Service-to-service credential for POST /v1/identities, used during sign-in before any user
# token exists. Also shared with the web app. Generate with: openssl rand -base64 32
API_SERVICE_KEY=

# CORS allowlist, comma-separated. Anything else is rejected before work begins.
WEB_ORIGINS=http://localhost:3000

# How long an unconfirmed checkout holds a court before the sweeper releases it.
HOLD_TTL_MINUTES=10

# How far ahead recurring series are materialised as real bookings.
RECURRENCE_HORIZON_DAYS=365

# How long a waitlist offer stays claimable before moving to the next entry.
WAITLIST_CLAIM_MINUTES=30

LOG_LEVEL=debug
